{
  "name": "marina-bodywork-website",
  "private": true,
  "description": "Static site for Marina Bodywork. The npm package only exists to host check scripts - there is no build step.",
  "type": "module",
  "scripts": {
    "check": "node scripts/run-all.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:jsonld": "node scripts/check-jsonld.mjs",
    "check:acuity": "node scripts/check-acuity.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:head": "node scripts/check-head.mjs",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:pricing": "node scripts/check-pricing.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:css": "node scripts/check-css.mjs",
    "check:smoke": "node scripts/smoke-app.mjs",
    "check:html": "html-validate --config .htmlvalidate.json *.html",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks',{stdio:'ignore'})}catch{}\""
  },
  "devDependencies": {
    "html-validate": "^9.0.0",
    "jsdom": "^25.0.0"
  }
}
